{{ form_start(form) }}
<section>
<div class="row">
    <div class="col-sm-12  col-md-6">
        <div class="card">
            <div class="card-header">
                <h1>Comisión Cobrador</h1>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-12 col-md-3">
                        <small class="text-muted">Días max.</small>
                        {{form_row(form.maxDiasComision,{'label':false,'attr':{'class':'form-control'}})}}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-12  col-md-6">
        <div class="card">
            <div class="card-header">
                <h1>Multa Desiste</h1>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-12 col-md-3">
                        <small class="text-muted">Valor</small>
                        {{form_row(form.valorMulta,{'label':false,'attr':{'class':'form-control'}})}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</section>
   
    <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
