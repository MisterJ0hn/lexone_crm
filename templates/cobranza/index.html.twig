{% extends 'base.html.twig' %}

{% block title %}{% endblock %}

{% block body %}

    <section>
    <div class="row">
        {% set total = 0 %}
        <!--<div class="col-sm-6 col-md-3">
            
            <div class="info-box">
                <span class="info-box-icon "></span>
    
                <div class="info-box-content">
                <span class="info-box-text">Segmento</span>
                <span class="info-box-number">Todos</span>
            
                <a href="#" class="small-box-footer" onclick="javascript:buscar('')">
                    Ver mas <i class="fas fa-arrow-circle-right"></i>
                </a>
          
                </div>

                
               
            </div>
            
        </div>-->
        {% for vencimiento in vencimientos  %}
        <div class="col-sm-6 col-md-3">
            
            <div class="info-box">
                <span class="info-box-icon text-{{vencimiento.color}}"><i class="{{ vencimiento.icono }}"></i></span>
    
                <div class="info-box-content">
                <span class="info-box-text">{{vencimiento.nombre}}</span>
                <span class="info-box-number">{{vencimiento.valMin}} -  {{vencimiento.valMax}} </span>
            
                <a href="#" class="small-box-footer" onclick="javascript:buscar({{vencimiento.id}})">
                    Ver mas <i class="fas fa-arrow-circle-right"></i>
                </a>
          
                </div>

                
                <!-- /.info-box-content -->
            </div>
            
        </div>
       {% endfor %}
        
    </div>
    </section>
    <div class="alert alert-{{vencimientoSeleccionado.color}}" role="alert">
        <h4 class="alert-heading"> {{vencimientoSeleccionado.nombre}}</h4>
    </div>

    <form action="" method="get" class="frmBuscar">
        {{ include('filtro.html.twig') }}
        <input type="hidden" id="bStatus" name="bStatus">
    </form>
    
    <div class="card">
        <div class="card-body table-responsive p-0" style="height: 500px;">
        
            <table class="table table-head-fixed text-nowrap table-striped table-sm">
                <thead>
                    <tr>

                        <th>{{ knp_pagination_sortable(cuotas, 'Cliente', 'contrato.cliente.nombre') }} {% if cuotas.isSorted('contrato.cliente.nombre') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        
                        <th style="text-align:center">{{ knp_pagination_sortable(cuotas, 'Vcto', 'fechaPago') }} {% if cuotas.isSorted('fechaPago') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        <th style="text-align:center">D.Mora</th>
                        
                        <th style="text-align:right">V.Cuota</th>
                        <th style="text-align:right">$Mora</th>
                        <th style="text-align:center">U.Pago</th>
                        <th style="text-align:center">{{ knp_pagination_sortable(cuotas, 'Compromiso', 'contrato.fechaCompromiso') }} {% if cuotas.isSorted('contrato.fechaCompromiso') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        <th style="text-align:center">C.Pgda</th>
                      
                        <th>{{ knp_pagination_sortable(cuotas, 'Anexo', 'contrato.isAnexo') }} {% if cuotas.isSorted('contrato.isAnexo') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        {% if finalizado is null or not finalizado %}

                        <th><i class="fas fa-traffic-light"></i></th>
                        
                        
                        {% endif %}
                        
                        <th>Ver</th>
                    </tr>
                </thead>
                <tbody>
    
                {% for cuota in cuotas %}
              
                {% set contrato = cuota.contrato %}
                {% set enmora = cuota.monto - cuota.pagado %}
                {% set diferencia=(date('now').diff(cuota.fechaPago)) %}
                    <tr>
               
                        <td>{{ contrato.cliente.nombre }}</td>
                       
                        <td align="center">{{ cuota.fechaPago|date('d-m-Y') }}</td>
                       
                        
                        <td align="center">
                        {%  if cuota.fechaPago %}
                        {{ diasmora(cuota.fechaPago|date('Y-m-d'))<0?0:diasmora(cuota.fechaPago() |date('Y-m-d'))}} dias
                        {% endif %}
                         </td>
                        <td align="right">
                        {% if cuota.isMulta != true %}

                            ${{ cuota.monto|number_format(0,',','.') }}
                        {% endif %}
                        </td>
                        <td align="right">${{ montoDeuda(contrato.id)|number_format(0, ',', '.') }}</td>
                        
                        <td align="center">{{ ultimoPago(contrato.id) ? ultimoPago(contrato.id) |date('d-m-Y H:i') : '' }}</td>
                       
                        <td align="center">{{ contrato.fechaCompromiso ? contrato.fechaCompromiso|date('d-m-Y'):''}}</td>
                        <td align="center">{{ totalesCobranza(contrato.id) }}</td>
                     
                        <td align="center">
                            {% if contrato.isAnexo %}
                                <i class="fas fa-check"></i>
                            {% endif %}
                        </td>
                        {% if finalizado is null or not finalizado %}
                        <td>
                           {{semaforo(cuota.fechaPago|date('Y-m-d'))|raw}}
                        </td>
                        {% endif %}  
                        <td>
                             <a href="{{ path('vercobranza_view', {'id': contrato.id}) }}" class="btn btn-success btn-sm"><i class="far fa-eye"></i></a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="11">No hay contratos</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <div class="card-footer clearfix">
                {# display navigation #}
           <div class="navigation">
               {{ knp_pagination_render(cuotas,'@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig',{},{
               'position': 'centered',
               'rounded': true,
               }) }}
           </div>
       </div>
            
        </div>
    </div>
    <script>
        $('#bFecha').daterangepicker({
        
            "drops": "down",
            "startDate":"{{sesion.getEmpresaActual.fechaIngreso|date('Y-m-d')}}",
            "endDate": "{{dateFin}}",
            "locale": {
                "format": "YYYY-MM-DD",
                "applyLabel": "Apply",
                "cancelLabel": "Cancel",
            }
        }, function(start, end, label) {
        console.log('New date range selected: ' + start.format('YYYY-MM-DD') + ' to ' + end.format('YYYY-MM-DD') + ' (predefined range: ' + label + ')');
        
        });
        $(".bFolio").change(function(){
            $(".bFiltro").val('');
        });
        $(".bFiltro").change(function(){
            $(".bFolio").val('');
        });

    $(".exportarxslx").on('click',function(){
        $(".frmBuscar").attr('action',"{{path('cobranza_excel')}}");
        $(".frmBuscar").submit();

        $("button").prop('disabled',false);
    });

    $(".buscar").on('click',function(){
        $(".frmBuscar").attr('action',"{{path('cobranza_index')}}");
        $(".frmBuscar").submit();
    });

    function buscar(status){
        $("#bStatus").val(status);
        $(".frmBuscar").submit();
    }
    </script>
{% endblock %}
