{{ form_start(form) }}
<div class="card">
    <div class="card-body table-responsive pad">

        <div class="row">
            
            <div class="col-sm-12 col-md-6">
                <small class="text-muted">Seleccione archivo</small><br>
                {{form_row(form.url,{'label':false, 'attr': {'accept': '.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.ods,.txt,.csv,.jpg,.jpeg,.png,.gif,.zip'}})}}
                <small class="text-muted">Máximo 20 MB. Formatos: PDF, Word, Excel, PowerPoint, OpenOffice, TXT, CSV, JPG, PNG, GIF y ZIP.</small>
                
            </div>
            <div class="col-sm-12 col-md-3">
                <button class="btn btn-primary mt-3" >{{ button_label|default('Subir') }}</button>
            </div>
        </div>
    </div>
    
</div>
    
    
{{ form_end(form) }}
