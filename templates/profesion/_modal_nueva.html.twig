{#
  Modal global "Nueva profesión u oficio" (se incluye una vez por página). Cualquier select de profesión
  dentro de un .input-group con un botón [data-profesion-nueva] lo abre; al guardar, la opción queda
  agregada y seleccionada en ese select. Los manejadores son delegados: sirven también para formularios cargados por AJAX.
#}
<div class="modal fade" id="modalProfesionNueva" tabindex="-1" role="dialog" aria-hidden="true"
     data-url="{{ path('profesion_rapido') }}"
     data-csrf="{{ csrf_token('profesion_rapido') }}">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nueva profesión u oficio</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="text" id="profesionNuevaNombre" class="form-control" maxlength="255" placeholder="Profesión u oficio" autocomplete="off">
                <div id="profesionNuevaError" class="text-danger small mt-1"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="profesionNuevaGuardar">Agregar</button>
            </div>
        </div>
    </div>
</div>
<script>
(function () {
    var $modal = $('#modalProfesionNueva').appendTo('body'), $select = null;

    $(document).on('click', '[data-profesion-nueva]', function () {
        $select = $(this).closest('.input-group').find('select').first();
        $('#profesionNuevaError').text('');
        $('#profesionNuevaNombre').val('');
        $modal.modal('show');
    });
    $modal.on('shown.bs.modal', function () { $('#profesionNuevaNombre').trigger('focus'); });
    // Si se abrió desde otro modal (p. ej. "Nuevo cliente"), al cerrar este el otro debe seguir desplazable.
    $modal.on('hidden.bs.modal', function () { if ($('.modal.show').length) { $('body').addClass('modal-open'); } });
    $('#profesionNuevaNombre').on('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); $('#profesionNuevaGuardar').click(); } });

    $('#profesionNuevaGuardar').on('click', function () {
        var nombre = $.trim($('#profesionNuevaNombre').val());
        if (!nombre) { $('#profesionNuevaError').text('Ingrese la profesión u oficio.'); return; }
        var $btn = $(this).prop('disabled', true);
        $.ajax({
            url: $modal.data('url'),
            type: 'post',
            data: { nombre: nombre },
            headers: { 'X-CSRF-Token': $modal.data('csrf') },
            dataType: 'json'
        }).done(function (r) {
            if (!$select.find('option').filter(function () { return this.value === r.nombre; }).length) {
                $select.append($('<option>').val(r.nombre).text(r.nombre));
            }
            $select.val(r.nombre).trigger('change');
            $modal.modal('hide');
        }).fail(function (xhr) {
            $('#profesionNuevaError').text((xhr.responseJSON && xhr.responseJSON.detail) || 'No se pudo agregar la profesión.');
        }).always(function () { $btn.prop('disabled', false); });
    });
})();
</script>
