{% extends 'base.html.twig' %}
{% import 'lexflow/_macros.html.twig' as m %}
{% import 'pjud/_boton.html.twig' as pjud %}

{% block title %}Estado Diario{% endblock %}

{% block body %}
{# "Leído" va en medio del grupo (detalle PJUD · leído · pendiente): al estar dentro de su propio form, el tema le redondea las esquinas. #}
<style>
    .btn-group > form.btn-group > .btn.btn-leido-centro { border-radius: 0; }
</style>
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Estado Diario</h3>
        <div class="card-tools text-muted">{{ datos.total|default(0) }} registros encontrados</div>
    </div>
    <div class="card-body">
        {% include 'lexflow/_tabs.html.twig' %}

        {% if tab == 'materias' %}
            <ul class="nav nav-pills mb-3">
                {% for k, label in tabs_estado %}
                    <li class="nav-item">
                        <a class="nav-link {{ estado == k ? 'active' }}" href="{{ path('ed_estado_diario_index', app.request.query.all|merge({estado: k, page: 1})) }}">
                            {{ label }} {% if conteos[k] is defined %}<span class="badge badge-light">{{ conteos[k] }}</span>{% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>

            <form method="get" class="form-row mb-3">
                <input type="hidden" name="tab" value="materias">
                <input type="hidden" name="estado" value="{{ estado }}">
                <div class="col-md-3 mb-2">
                    <label class="small mb-0">Jurisdicción</label>
                    <select name="jurisdiccion" class="form-control form-control-sm">
                        <option value="">Todas</option>
                        {% for j in jurisdicciones %}
                            <option value="{{ j.id }}" {{ filtros.jurisdiccion|default('') == j.id ? 'selected' }}>{{ j.nombre }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <label class="small mb-0">Fecha desde</label>
                    <input type="date" name="fecha_desde" class="form-control form-control-sm" value="{{ filtros.fecha_desde|default('') }}">
                </div>
                <div class="col-md-2 mb-2">
                    <label class="small mb-0">Fecha hasta</label>
                    <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="{{ filtros.fecha_hasta|default('') }}">
                </div>
                <div class="col-md-3 mb-2">
                    <label class="small mb-0">RUT</label>
                    <input type="text" name="rut" class="form-control form-control-sm" placeholder="Ej: 16952077-1" value="{{ filtros.rut|default('') }}">
                </div>
                <div class="col-md-2 mb-2 d-flex align-items-end">
                    <button class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Aplicar</button>
                </div>
            </form>
            {% include 'lexflow/_chips.html.twig' %}

            <div class="table-responsive">
                <table class="table table-sm table-striped text-nowrap">
                    <thead>
                        <tr>
                            <th>Rit/Rol</th><th>Ruc/RolUnico</th><th>FechaIngreso</th><th>Caratulado</th>
                            <th>Tribunal</th><th>TipoCausa</th><th>Estado</th><th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for r in datos.movimientos|default([]) %}
                        <tr>
                            <td class="font-weight-bold">{{ m.dato(r.rol) }}</td>
                            <td>{{ m.dato(r.rol_unico) }}</td>
                            <td class="text-nowrap">{{ m.dato(r.fecha_ingreso) }}</td>
                            <td title="{{ r.caratulado }}">{{ m.dato(r.caratulado) }}</td>
                            <td>{{ m.dato(r.tribunal) }}</td>
                            <td>{{ m.dato(r.tipo_causa) }}</td>
                            <td>
                                {% if r.leido %}
                                    <span class="badge badge-success">Resuelto</span>
                                {% elseif r.pendiente %}
                                    <span class="badge {{ r.nivel_pendiente == 'alto' ? 'badge-danger' : (r.nivel_pendiente == 'medio' ? 'badge-warning' : 'badge-secondary') }}">Pendiente - {{ r.nivel_pendiente }}</span>
                                {% else %}
                                    <span class="badge badge-secondary">No leído</span>
                                {% endif %}
                            </td>
                            <td class="text-nowrap text-right">
                                <div class="btn-group" role="group">
                                    
                                {{ pjud.boton(r.crm_causa_id|default(r.pjud_token|default(null)), r.pjud_estado|default('nuevo')) }}
                               
                                {% if r.id is defined %}
                                    {% set accion = r.leido ? 'no_leido' : 'leido' %}
                                    <form method="post" action="{{ path('ed_estado_diario_' ~ accion, {id: r.id}) }}" class="btn-group">
                                        <input type="hidden" name="_token" value="{{ csrf_token('ed_' ~ accion|replace({'_': '-'}) ~ r.id) }}">
                                        {% for k, v in app.request.query.all %}
                                            {% if v is not iterable %}<input type="hidden" name="query[{{ k }}]" value="{{ v }}">{% endif %}
                                        {% endfor %}
                                        {% if r.leido %}
                                            <button type="submit" class="btn btn-outline-secondary btn-sm px-2" title="Marcar como no leído">
                                                <i class="fas fa-undo"></i>
                                            </button>
                                        {% else %}
                                            <button type="submit" class="btn btn-outline-success btn-sm px-2 btn-leido-centro" title="Marcar como leído">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        {% endif %}
                                    </form>
                                {% endif %}
                                 {% if r.id is defined and not r.leido %}
                                    <button type="button" class="btn btn-outline-warning btn-sm px-2 btn-pendiente" title="Marcar como pendiente"
                                            data-action="{{ path('ed_estado_diario_pendiente', {id: r.id}) }}"
                                            data-token="{{ csrf_token('ed_pendiente' ~ r.id) }}">
                                        <i class="fas fa-clock"></i>
                                    </button>
                                {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="text-center text-muted py-4">No se encontraron registros del estado diario</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {# Popup "Marcar como pendiente": deja el registro pendiente con el nivel elegido y agenda el recordatorio. #}
            <div class="modal fade" id="modalPendiente" tabindex="-1" role="dialog" aria-labelledby="modalPendienteLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <form method="post" class="modal-content" id="formPendiente">
                        <input type="hidden" name="_token" id="pendienteToken">
                        {% for k, v in app.request.query.all %}
                            {% if v is not iterable %}<input type="hidden" name="query[{{ k }}]" value="{{ v }}">{% endif %}
                        {% endfor %}
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalPendienteLabel">Marcar como pendiente</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
                        </div>
                        <div class="modal-body">
                            <p class="small text-muted">El registro queda pendiente con el nivel de urgencia indicado y se agenda el recordatorio.</p>
                            <div class="form-group">
                                <label for="pendienteNivel">Nivel de urgencia</label>
                                <select name="nivel" id="pendienteNivel" class="form-control">
                                    <option value="bajo">Bajo</option>
                                    <option value="medio">Medio</option>
                                    <option value="alto">Alto</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="pendienteDetalle">Detalle</label>
                                <textarea name="detalle" id="pendienteDetalle" class="form-control" rows="3" required placeholder="Descripción del recordatorio..."></textarea>
                            </div>
                            <div class="form-group">
                                <label for="pendienteFecha">Fecha del recordatorio</label>
                                <input type="date" name="fecha" id="pendienteFecha" class="form-control" required>
                                <small class="form-text text-muted">Se agrega como evento de todo el día en tu Google Calendar (si está conectado).</small>
                            </div>
                            {# El WhatsApp solo se ofrece en el nivel alto: la API lo rechaza en los demás. #}
                            <div id="pendienteWhatsapp" style="display:none">
                                <hr>
                                <div class="custom-control custom-checkbox mb-2">
                                    <input type="checkbox" class="custom-control-input" id="pendienteNotificar" name="notificar_whatsapp" value="1">
                                    <label class="custom-control-label" for="pendienteNotificar">Notificar por WhatsApp</label>
                                </div>
                                <div class="form-row" id="pendienteWhatsappDatos" style="display:none">
                                    <div class="col-md-6 form-group">
                                        <label for="pendienteTelefono">Teléfono</label>
                                        <input type="text" name="whatsapp_telefono" id="pendienteTelefono" class="form-control" placeholder="+56912345678" value="{{ app.user.telefono|default('') }}">
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="pendienteHora">Hora de envío</label>
                                        <input type="time" name="whatsapp_hora" id="pendienteHora" class="form-control" value="09:00">
                                        <small class="form-text text-muted">Se enviará el día del recordatorio.</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
            <script>
                $(function () {
                    var $modal = $('#modalPendiente');
                    var $nivel = $('#pendienteNivel');
                    var $notificar = $('#pendienteNotificar');
                    function sincronizar() {
                        var alto = $nivel.val() === 'alto';
                        $('#pendienteWhatsapp').toggle(alto);
                        if (!alto) { $notificar.prop('checked', false); }
                        $('#pendienteWhatsappDatos').toggle(alto && $notificar.is(':checked'));
                    }
                    $nivel.on('change', sincronizar);
                    $notificar.on('change', sincronizar);
                    $('.btn-pendiente').on('click', function () {
                        $('#formPendiente').attr('action', $(this).data('action'));
                        $('#pendienteToken').val($(this).data('token'));
                        $nivel.val('bajo');
                        $('#pendienteDetalle, #pendienteFecha').val('');
                        $notificar.prop('checked', false);
                        sincronizar();
                        $modal.modal('show');
                    });
                });
            </script>

            {# Diagnóstico del botón "Detalle PJUD" (martillo): por qué aparece o no. #}
            <p class="small text-muted mb-0">
                {% if not pjud_info.configurado %}
                    Detalle PJUD: la empresa no lo tiene habilitado o le faltan email y password de api-pjud (Empresa → editar).
                {% else %}
                    Detalle PJUD: {{ pjud_info.coinciden + pjud_info.externas }} de {{ datos.movimientos|default([])|length }} filas de esta página tienen detalle ({{ pjud_info.coinciden }} del CRM, con la clave del cliente; {{ pjud_info.externas }} fuera del CRM, con su clave PJUD de Mis Datos){% if pjud_info.sin_soporte %}. {{ pjud_info.sin_soporte }} no se pueden consultar (materia no soportada o rol sin formato LETRA-NÚMERO-AÑO){% endif %}.
                {% endif %}
            </p>
        {% else %}
            {% include 'lexflow/_filtros_corte.html.twig' with {placeholder_busqueda: 'Carátula o número de ingreso'} %}

            <div class="table-responsive">
                <table class="table table-sm table-striped text-nowrap">
                    <thead>
                        <tr><th>FechaIngreso</th><th>Caratulado</th><th>Ubicación</th><th>FechaUbicación</th><th>Corte</th><th>TipoRecurso</th></tr>
                    </thead>
                    <tbody>
                    {% for c in datos.cortes|default([]) %}
                        <tr>
                            <td class="text-nowrap">{{ m.fecha(c.fecha_ingreso) }}</td>
                            <td>{{ m.dato(c.caratulado) }}</td>
                            <td>{{ m.dato(c.ubicacion) }}</td>
                            <td class="text-nowrap">{{ m.fecha(c.fecha_ubicacion) }}</td>
                            <td>{{ m.dato(c.corte) }}</td>
                            <td>{{ m.dato(c.tipo_recurso|default(c.tipo|default(null))) }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-center text-muted py-4">No hay causas de corte</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
        {% include 'lexflow/_paginacion.html.twig' %}
    </div>
</div>
{% endblock %}
