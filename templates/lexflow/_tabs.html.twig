{# Tabs principales Materias / Cortes. Requiere: tab #}
{% set ruta = app.request.attributes.get('_route') %}
{% if error %}
<div class="alert alert-danger">{{ error }}</div>
{% endif %}
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link {{ tab == 'materias' ? 'active' }}" href="{{ path(ruta, {tab: 'materias'}) }}">Materias</a></li>
    <!--<li class="nav-item"><a class="nav-link {{ tab == 'cortes' ? 'active' }}" href="{{ path(ruta, {tab: 'cortes'}) }}">Cortes</a></li>-->
</ul>
