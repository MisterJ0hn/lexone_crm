<div class="card bg-calipso">
    
        <div class="card-body">
            
            <div class="row">
                
                <div class="col-sm-12 col-md-2">
                    <select class="form-control" name="bTipoCliente" title="Cliente">
                        <option value="">Cliente: todos</option>
                        {% for tipo in ['Persona', 'Empresa', 'Convenio'] %}
                        <option value="{{ tipo }}"{{ app.request.query.get('bTipoCliente') == tipo ? ' selected' : '' }}>{{ tipo }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-sm-12 col-md-4">
                    <input type="text" class="form-control" name="bFiltro" placeholder="Nombre/Email/Teléfono" value="{{bFiltro}}">
                </div>

                

                <div class="col-sm-12 col-md-4">
                    <input type="text" class="form-control" name="bFecha" id="bFecha"  value="">
                </div>
                <div class="col-sm-12 col-md-2">
                    <button class="btn btn-primary"><i class="fas fa-search"></i></button>
                </div>
                

            </div>
            
        </div>  
        
    </div>
    