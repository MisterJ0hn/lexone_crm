{#
  Línea de tiempo (estilo AdminLTE) agrupada por día, de lo más reciente a lo más antiguo.
  Variables:
    items   lista de {fecha: DateTime|null, titulo: string, usuario: string, texto: string, archivo?: {url, nombre}, icono?: 'fa-comment'}
            en orden cronológico: se muestra de lo más antiguo a lo más reciente.
    origen  (opcional) {fecha, etiqueta}: hito inicial que se muestra primero (p. ej. la carga de la agenda).
#}
{% if items|length or origen is defined and origen %}
<div class="timeline">
    {% if origen is defined and origen %}
        <div class="time-label"><span class="bg-red">{{ origen.fecha ? origen.fecha|date('d-m-Y H:i') : '' }}</span></div>
        <div>
            <i class="fas fa-flag bg-gray"></i>
            <div class="timeline-item"><div class="timeline-body">{{ origen.etiqueta }}</div></div>
        </div>
    {% endif %}
    {% set diaActual = null %}
    {% for item in items|sort((a, b) => (a.fecha ? a.fecha.timestamp : 0) <=> (b.fecha ? b.fecha.timestamp : 0)) %}
        {% set dia = item.fecha ? item.fecha|date('d-m-Y') : '' %}
        {% if dia != diaActual %}
            {% set diaActual = dia %}
            <div class="time-label"><span class="bg-primary">{{ dia ?: 'Sin fecha' }}</span></div>
        {% endif %}
        <div>
            <i class="fas {{ item.icono|default(item.archivo is defined and item.archivo ? 'fa-paperclip' : 'fa-comment') }} bg-blue"></i>
            <div class="timeline-item">
                <span class="time"><i class="fas fa-clock"></i> {{ item.fecha ? item.fecha|date('H:i') : '' }}</span>
                <h3 class="timeline-header">
                    {% if item.titulo|default('') %}<span class="badge badge-primary mr-1">{{ item.titulo }}</span>{% endif %}
                    <strong>{{ item.usuario|default('') }}</strong>
                </h3>
                <div class="timeline-body" style="white-space: pre-line;">{{ item.texto }}</div>
                {% if item.archivo is defined and item.archivo %}
                <div class="timeline-footer">
                    <a href="{{ item.archivo.url }}" class="btn btn-primary btn-sm"><i class="fas fa-download"></i> {{ item.archivo.nombre }}</a>
                </div>
                {% endif %}
            </div>
        </div>
    {% endfor %}
    <div><i class="fas fa-clock bg-gray"></i></div>
</div>
{% else %}
    <p class="mb-0 text-center text-muted">Aún no hay registros.</p>
{% endif %}
