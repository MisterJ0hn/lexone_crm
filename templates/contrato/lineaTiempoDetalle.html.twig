{% extends 'base.html.twig' %}

{% block title %}Contrato{% endblock %}

{% block body %}

<div class="row">
    <div class="col-sm-12 col-md-12 ">
        {{ include('cabezera.html.twig') }}
        

        <div class="row">
            <div class="col-sm-12 col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Observaciones</h4>
                        <div class="card-tools">

                            <a class="btn  btn-sm btn-primary rounded-circle" data-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample"><i class="fa fa-plus bg-blue"></i></a>
                        </div>
                    </div>
                    <div class="card-body table-responsive">
                        <!-- The time line -->
                    
                        
                        <div >
                            <form  id="frmObservacion" class="frmObservacion" method="post" action="{{path('contrato_observacion',{'id':causa.id}) }}" onsubmit="return confirm('Estas seguro de ingresar esta observación?');" required>
                             
                                <textarea class="form-control" name="txtObservacion"></textarea>
                                <button class="btn btn-primary p-1 m-2" >Guardar Observación</button>
                            </form>

                        </div>
                        
                        <div class="collapse" id="collapseExample">
                            <div class="timeline">
                            <!-- timeline time label -->
                               
                            {% for observacion in observaciones %}
                                <div>
                                    <i class="fa fa-comments bg-blue"></i>
                                    <div class="timeline-item">
                                        <span class="time"><i class="fas fa-clock"></i>{{ observacion.fechaRegistro | date('Y-m-d H:i') }}</span>
                                        <h3 class="timeline-header"><a href="#">{{ observacion.usuarioRegistro.nombre }}</a> <!-- usuario --> </h3>

                                        <div class="timeline-body">
                                            {{ observacion.observacion | raw }}
                                        </div>
                                    
                                    </div>
                                </div>
                            {% endfor %}
                                 <div>
                                    <i class="fa fa-comments bg-blue"></i>
                                    <div class="timeline-item">
                                        <span class="time"><i class="fas fa-clock"></i>{{ contrato.fechaCreacion | date('Y-m-d H:i') }}</span>
                                        <h3 class="timeline-header"><a href="#">{{ contrato.agenda.abogado?contrato.agenda.abogado.nombre:''}}</a> <!-- usuario --> </h3>

                                        <div class="timeline-body">
                                            {{ contrato.observacion | raw }}
                                        </div>
                                    
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>

        
        <div class="row">
            <div class="col-sm-12 col-md-12">
                <div class="card">
                    <div class="card-body">
                        <h3>Estado Procesal</h3>
                        <table class="table table-sm" style="max-width:800px">
                        <tr><th></th><th>Etapa</th><th>Fecha Registro</th><th>Fecha Completado</th></tr>
                        {% if estadosProcesales is empty %}
                            <tr><td colspan="4">No hay estados procesales registrados.</td></tr>
                        {% endif %}
                        {% for estado in estadosProcesales %}
                            <tr>
                                <td style="width:60px; padding-bottom:12px;">
                                    {% if estado.completado %}
                                        <span class="btn btn-sm btn-success" title="Completado"><i class="fas fa-check-circle"></i></span>
                                    {% else %}
                                        <form method="post" action="{{ path('contrato_estado_procesal_completar', {'id': estado.id}) }}" onsubmit="return confirm('¿Marcar este estado como completado?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('estado_procesal' ~ causa.id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Pendiente: clic para completar"><i class="fas fa-times"></i></button>
                                        </form>
                                    {% endif %}
                                </td>
                                <td>
                                    <strong>{{ estado.nombre }}</strong>
                                    {% if estado.observacion %}<br><small class="text-muted">{{ estado.observacion }}</small>{% endif %}
                                </td>
                                <td class="text-muted text-nowrap"><small>{{  estado.fecha|date('d-m-Y H:i') }}</small></td>
                                <td class="text-muted text-nowrap"><small>{{ estado.fechaCompletado ?estado.fechaCompletado|date('d-m-Y H:i'):'' }}</small></td>
                            </tr>
                        {% endfor %}
                        </table>

                        {% if causa.estado and not causa.causaFinalizada %}
                        
                        <div class="collapse mt-3" id="nuevoEstadoProcesal">
                            <form method="post" action="{{ path('contrato_estado_procesal_agregar', {'id': causa.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('estado_procesal' ~ causa.id) }}">
                                <div class="row">
                                    <div class="col-sm-12 col-md-4">
                                        <div class="input-group">
                                            <select name="txtNombre" id="selEstadoProcesal" class="form-control" required>
                                                <option value="">Seleccione estado procesal</option>
                                                {% for tipo in tiposEstadoProcesal %}
                                                    <option value="{{ tipo.nombre }}">{{ tipo.nombre }}</option>
                                                {% endfor %}
                                            </select>
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-outline-primary" id="btnEstadoProcesalNuevo" title="Agregar un estado procesal que no está en el listado"><i class="fas fa-plus"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="col-sm-12 col-md-2">
                                        <button type="submit" class="btn btn-primary">Agregar</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="mt-2">
                            <button type="button" class="btn btn-primary" data-toggle="collapse" data-target="#nuevoEstadoProcesal" title="Agregar estado procesal"><i class="fas fa-plus"></i></button>
                            <form method="post" action="{{ path('contrato_estado_procesal_finalizar', {'id': causa.id}) }}" class="d-inline" onsubmit="return confirm('¿Finalizar esta causa?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('estado_procesal' ~ causa.id) }}">
                                <button type="submit" class="btn btn-success">Finalizar</button>
                            </form>
                        </div>
                        {% else %}
                        <span class="badge badge-secondary mt-2">Causa finalizada</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="modal fade" id="modalEstadoProcesalNuevo" tabindex="-1" role="dialog" aria-hidden="true"
     data-url="{{ path('estado_procesal_tipo_rapido') }}"
     data-csrf="{{ csrf_token('estado_procesal_tipo_rapido') }}">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo estado procesal</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="text" id="estadoProcesalNuevoNombre" class="form-control" maxlength="255" placeholder="Nombre del estado procesal">
                <div id="estadoProcesalNuevoError" class="text-danger small mt-1"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="estadoProcesalNuevoGuardar">Agregar</button>
            </div>
        </div>
    </div>
</div>
<script>
(function () {
    var $modal = $('#modalEstadoProcesalNuevo'), $select = $('#selEstadoProcesal');
    $('#btnEstadoProcesalNuevo').on('click', function () {
        $('#estadoProcesalNuevoError').text('');
        $('#estadoProcesalNuevoNombre').val('');
        $modal.modal('show');
    });
    $modal.on('shown.bs.modal', function () { $('#estadoProcesalNuevoNombre').trigger('focus'); });
    $('#estadoProcesalNuevoNombre').on('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); $('#estadoProcesalNuevoGuardar').click(); } });
    $('#estadoProcesalNuevoGuardar').on('click', function () {
        var nombre = $.trim($('#estadoProcesalNuevoNombre').val());
        if (!nombre) { $('#estadoProcesalNuevoError').text('Ingrese el nombre del estado procesal.'); return; }
        var $btn = $(this).prop('disabled', true);
        $.ajax({
            url: $modal.data('url'),
            type: 'post',
            data: { nombre: nombre },
            headers: { 'X-CSRF-Token': $modal.data('csrf') },
            dataType: 'json'
        }).done(function (r) {
            var existe = $select.find('option').filter(function () { return this.value === r.nombre; }).length;
            if (!existe) { $select.append($('<option>').val(r.nombre).text(r.nombre)); }
            $select.val(r.nombre).trigger('change');
            $modal.modal('hide');
        }).fail(function (xhr) {
            $('#estadoProcesalNuevoError').text((xhr.responseJSON && xhr.responseJSON.detail) || 'No se pudo agregar el estado procesal.');
        }).always(function () { $btn.prop('disabled', false); });
    });
})();
</script>
{% endblock %}
