{# JS sin etiqueta <script>: se incluye dentro del <script> de cada pantalla. #}
    // Campos de la causa que no se usan según la materia:
    //  - 9 Corte Suprema: solo rol y año (Letra, Corte y Tribunal desactivados).
    //  - 10 Corte de Apelaciones: rol, año y corte (Letra y Tribunal desactivados).
    var MATERIA_SUPREMA = 9;
    var MATERIA_APELACIONES = 10;
    function esApelacion(materiaId){
        materiaId = parseInt(materiaId, 10);
        return materiaId === MATERIA_SUPREMA || materiaId === MATERIA_APELACIONES;
    }
    function esSuprema(materiaId){
        return parseInt(materiaId, 10) === MATERIA_SUPREMA;
    }
    // Recibe los selectores de cada campo; vacía y desactiva los que la materia no usa,
    // y reactiva los demás. Cualquiera puede ser null si la pantalla no lo tiene.
    // Corte de Apelaciones: el caratulado es obligatorio (va en consultar_/sincronizar_apelaciones).
    function esCorteApelaciones(materiaId){
        return parseInt(materiaId, 10) === MATERIA_APELACIONES;
    }
    // true si el caratulado es válido para la materia; si no, avisa y devuelve false.
    function validaCaratuladoApelaciones(materiaId, caratulado){
        if(esCorteApelaciones(materiaId) && $.trim(caratulado || '') === ''){
            alert("Debe ingresar el caratulado para causas de Corte de Apelaciones");
            return false;
        }
        return true;
    }
    // Marca el campo caratulado como requerido (atributo required y placeholder) cuando la materia es Apelaciones.
    // El selector se deduce del de la letra (.txtLetra-x -> .txtCaratulado-x; en filas de tabla, el de la misma fila).
    function aplicaCaratuladoRequerido(materiaId, letraSel){
        var $c = typeof letraSel === 'string'
            ? $(letraSel.replace('txtLetra', 'txtCaratulado'))
            : $(letraSel).closest('tr, .agregar-causa-cliente').find('[class*="txtCaratulado"]');
        var req = esCorteApelaciones(materiaId);
        $c.prop('required', req).attr('placeholder', req ? 'Caratulado *' : 'Caratulado');
    }
    // Texto de la opción vacía del combo de tribunal: en Corte de Apelaciones no se usa tribunal, así que va sin texto.
    function textoSeleccioneTribunal(materiaId){
        return esCorteApelaciones(materiaId) ? '' : 'Seleccione Tribunal';
    }
    // Tras recargar el combo de tribunales al elegir una corte: en Corte de Apelaciones la opción vacía queda sin texto.
    function quitaTextoTribunalApelaciones(juzgadoSel, materiaId){
        if(esCorteApelaciones(materiaId)){
            $(juzgadoSel).find('option[value=""]').first().text('');
        }
    }
    // Solo en los formularios "Agregar causa" de la línea de tiempo (clases -nueva / -convenio / -cliente):
    // en Corte de Apelaciones se quita el texto "Letra", "N°" pasa a "Rol", "Año" a "Era" y la opción vacía del tribunal queda sin texto.
    function aplicaEtiquetasApelaciones(materiaId, letraSel, juzgadoSel){
        var apel = esCorteApelaciones(materiaId);
        var $letra, $rol, $anio;
        if(typeof letraSel === 'string'){
            if(!/-(nueva|convenio|cliente)$/.test(letraSel) && letraSel !== '.txtLetra'){ return; }
            $letra = $(letraSel); $rol = $(letraSel.replace('txtLetra', 'txtRol')); $anio = $(letraSel.replace('txtLetra', 'txtAnio'));
        } else {
            var $f = $(letraSel).closest('.agregar-causa-cliente');
            if(!$f.length){ return; }
            $letra = $f.find('.txtLetra-cliente'); $rol = $f.find('.txtRol-cliente'); $anio = $f.find('.txtAnio-cliente');
        }
        $letra.filter('input').attr('placeholder', apel ? '' : 'Letra');
        $letra.filter('select').find('option[value=""]').first().text(apel ? '' : ' Letra ');
        $rol.attr('placeholder', apel ? 'Rol' : 'N°');
        $anio.attr('placeholder', apel ? 'Era' : 'Año');
        if(juzgadoSel){
            $(juzgadoSel).find('option[value=""]').first().text(apel ? '' : 'Seleccione Tribunal');
        }
    }
    function aplicaCamposApelacion(materiaId, letraSel, juzgadoSel, corteSel){
        if(letraSel){ aplicaCaratuladoRequerido(materiaId, letraSel); aplicaEtiquetasApelaciones(materiaId, letraSel, juzgadoSel); }
        var sinLetraNiTribunal = esApelacion(materiaId);
        var sinCorte = esSuprema(materiaId);
        if(letraSel){
            if(sinLetraNiTribunal){ $(letraSel).val(''); }
            $(letraSel).prop('disabled', sinLetraNiTribunal);
        }
        if(juzgadoSel){
            if(sinLetraNiTribunal){ $(juzgadoSel).val(''); }
            $(juzgadoSel).prop('disabled', sinLetraNiTribunal);
        }
        if(corteSel){
            if(sinCorte){ $(corteSel).val(''); }
            $(corteSel).prop('disabled', sinCorte);
        }
    }
