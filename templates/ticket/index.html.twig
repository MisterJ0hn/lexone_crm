{% extends 'base.html.twig' %}

{% block title %}Ticket index{% endblock %}

{% block body %}
<form action="{{path('app_ticket_index')}}" method="get" id="bForm">
    <input type="hidden" name="bStatus" id="bStatus" value="{{status|default('')}}">
<section>
    
    <div class="row">
        {% set total = 0 %}
        {% for resumen in resumenes %}
       
        <div class="col-sm-6 col-md-3">
            
            <div class="info-box">
                <span class="info-box-icon bg-{{resumen[0].estado.color}}""><i class="{{resumen[0].estado.icon}}""></i></span>
    
                <div class="info-box-content">
                <span class="info-box-text">{{resumen[0].estado.nombre}}</span>
                <span class="info-box-number">{{resumen.valor}}</span>
                {% set total= total + resumen.valor %}
                <a href="#" class="small-box-footer" onclick="javascript:buscar({{resumen[0].estado.id}})">
                    Ver Más <i class="fas fa-arrow-circle-right"></i>
                </a>
                </div>

                
                <!-- /.info-box-content -->
            </div>
      
        </div>
        {% endfor %}
        
        
    </div>
    
</section>
<section class="{% if status is null %}
    ocultar-campo
    {% endif %}">
    
    {{ include('filtro.html.twig') }}
</section>
</form>


<div class="card card-outline card-info collapsed-card">
   
    <div class="card-header">
        <h1 class="card-title">Agregar Ticket</h1>
        <div class="card-tools">
        <button type="button" class="btn btn-sm btn-primary rounded-circle" data-card-widget="collapse"><i class="fas fa-plus"></i>
        </button>
        
      </div>
    </div>
    
    <div class="card-body">
        <form action="{{path('app_ticket_search')}}" id="bFormNewTicket" method="post">
            <div class="row">
                <div class="col-sm-6 col-md-3">
                    <input type="text" placeholder="Folio Sac" name="txtFolio" class="form-control">
                </div>
            <div class="col-sm-6 col-md-3">
                    <input type="text" placeholder="Nombre/Email/Teléfono" name="txtNombreRut" class="form-control">
                </div>
                <div class="col-sm-12 col-md-3">
                    <button class="btn btn-primary"><i class="fas fa-search"></i></button>
                </div>

            </div>
        </form>
        
    </div>

</div>
<section class="{% if status is null %}
    ocultar-campo
    {% endif %}">
{% if total>0 %}
   
        {{ render(controller('App\\Controller\\TicketController::resumen', {'ticketEstado':status,'fechainicio':dateInicio,'fechafin':dateFin,'compania':bCompania,'filtro':'','totalStatus':total,'tipoFecha':tipoFecha,'origen':origen})) }}
{% endif %}
</section>
<div class="card {% if status is null %}
    ocultar-campo
    {% endif %}">
    <div class="card-body">

        <div class="table-responsive" style="height: 500px;">
            <table class="table table-head-fixed text-nowrap table-striped table-sm">
                <thead>
                    <tr>
                        <th>{{ knp_pagination_sortable(tickets, 'FolioSac', 'folioSac') }} {% if tickets.isSorted('folioSac') %} <i class="fas fa-sort"></i>{% endif %}</th>
                       <!-- <th>{{ knp_pagination_sortable(tickets, 'Estado', 'estado.nombre') }} {% if tickets.isSorted('estado.nombre') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        
                        <th>{{ knp_pagination_sortable(tickets, 'Folio', 'contrato.folio') }} {% if tickets.isSorted('contrato.folio') %} <i class="fas fa-sort"></i>{% endif %}</th>-->
                        <th>{{ knp_pagination_sortable(tickets, 'IngresadoPor', 'origen.nombre') }} {% if tickets.isSorted('origen.nombre') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        <th>{{ knp_pagination_sortable(tickets, 'Cliente', 'contrato.nombre') }} {% if tickets.isSorted('contrato.nombre') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        <!--<th>{{ knp_pagination_sortable(tickets, 'Destino', 'destino.nombre') }} {% if tickets.isSorted('destino.nombre') %} <i class="fas fa-sort"></i>{% endif %}</th>-->
                        <th>{{ knp_pagination_sortable(tickets, 'Encargado', 'encargado.nombre') }} {% if tickets.isSorted('encargado.nombre') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        <th>{{ knp_pagination_sortable(tickets, 'Nuevo', 'fechaNuevo') }} {% if tickets.isSorted('fechaNuevo') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        <th>{{ knp_pagination_sortable(tickets, 'Pendiente', 'fechaAsignado') }} {% if tickets.isSorted('fechaAsignado') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        <!--<th>{{ knp_pagination_sortable(tickets, 'Fecha Resuelto', 'fechaRespuesta') }} {% if tickets.isSorted('fechaRespuesta') %} <i class="fas fa-sort"></i>{% endif %}</th>-->
                        <th>{{ knp_pagination_sortable(tickets, 'Finalizado', 'fechaCierre') }} {% if tickets.isSorted('fechaCierre') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for ticket in tickets %}
                    <tr>
                        <td>{{ ticket.folioSac }}</td>
                        <!--<td>{{ ticket.estado ? ticket.estado:'' }}</td>
                         <td>{{ ticket.contrato.folio }}</td>-->
                        <td>{{ ticket.origen.nombre }}</td>
                        <td>{{ ticket.contrato.cliente.nombre }}</td>
                        <!--<td>{{ ticket.destino ? ticket.destino.nombre: '' }}</td>-->
                        <td>{{ ticket.encargado ? ticket.encargado.nombre: '' }}</td>
                        <td>{{ ticket.fechaNuevo ? ticket.fechaNuevo|date('Y-m-d H:i') : '' }}</td>
                        <td>{{ ticket.fechaAsignado ? ticket.fechaAsignado|date('Y-m-d H:i') : '' }}</td>
                        <!--<td>{{ ticket.fechaRespuesta ? ticket.fechaRespuesta|date('Y-m-d H:i') : '' }}</td>-->
                        <td>{{ ticket.fechaCierre ? ticket.fechaCierre|date('Y-m-d H:i') : '' }}</td>
                        <td align="center"><a href="{{path('app_ticket_gestionar',{'id':ticket.id})}}" class="btn"><i class="far fa-paper-plane"></i></a></td>
                       
                    
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>


<script>
    $('#bFecha').daterangepicker({
        
        "drops": "up",
        "startDate":"{{dateInicio}}",
        "endDate": "{{dateFin}}",
        "locale": {
            "format": "YYYY-MM-DD",
            "applyLabel": "Apply",
            "cancelLabel": "Cancel",
        }
    }, function(start, end, label) {
    console.log('New date range selected: ' + start.format('YYYY-MM-DD') + ' to ' + end.format('YYYY-MM-DD') + ' (predefined range: ' + label + ')');
    
    });
    function buscar(status){
        $("#bStatus").val(status);
        $("#bForm").submit();
    }
</script>

{% endblock %}
