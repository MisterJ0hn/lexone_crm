{% extends 'base.html.twig' %}

{% block title %}{{pagina|default('')}}{% endblock %}

{% block body %}
{{ include('cabezera.html.twig') }}
<div class="row">
    <div class="col-sm-12 col-md-9 ">
        <section class="sticky-top">
            <div class="card">
                <div class="card-body">
                    
                    
                    
                    {% if ticket.estado.id == 4 %}
                        
                            {{ include('ticket/_cerrado.html.twig') }}
                            
                    {% endif %}

                    {% if sesion.getSesion.usuarioTipo.id in [1,8,13,3] %}
                        
                        {% if ticket.estado.id == 2 %}
                        
                            {{ include('ticket/_respuesta.html.twig') }}
                        
                        {% endif %}
                        {% if ticket.estado.id == 1 %}
                        
                            {{ include('ticket/_asignar.html.twig') }}

                        {% endif %}
                        {% if ticket.estado.id == 3 %}
                    
                        {{ include('ticket/_cerrar.html.twig') }}
                        
                        {% endif %}
                    {% else %}
                        {% if ticket.estado.id == 2 %}
                            {% if  sesion.getSesion.id == ticket.encargado.id %}
                                {{ include('ticket/_respuesta.html.twig') }}
                            {% endif %}
                            
                            
                        {% endif %}
                    {% endif %}
                    
                </div>
            </div>
            </section>
    </div>
    <div class="col-sm-12 col-md-3">
    <!-- Main content -->
    {% set itemsHistorial = [] %}
{% for h in ticket.ticketHistorials %}
    {% set itemsHistorial = itemsHistorial|merge([{
        fecha: h.fecha,
        titulo: '' ~ h.estado,
        usuario: '' ~ h.usuarioRegistro,
        texto: h.observacion
    }]) %}
{% endfor %}
{{ include('components/_historial_panel.html.twig', {items: itemsHistorial, origen: {fecha: ticket.fechaNuevo, etiqueta: 'Ticket ingresado'}, titulo: 'Histórico', id: 'historial'}) }}

    </div>
    </div>


<script>
    $.ajax({
        url:"/usuario/3/combo",
        type: "post",
        dataType: "html",
        cache: false,
        contentType: false,
        processData: false,
        async: true,
        beforeSend: function(){
            $(".loading").html(' <div class="overlay"><i class="fas fa-sync-alt fa-spin"></i><div class="text-bold pt-2">Loading...</div></div>');
            
        },
        success:function(data){
            $(".encargado").html(data);
            $(".loading").html('');
        }

    });
    $('.destino').on('change',function(){
        $.ajax({
            url:"/usuario/"+$(this).val()+"/combo",
            type: "post",
            dataType: "html",
            cache: false,
            contentType: false,
            processData: false,
            async: true,
            beforeSend: function(){
                $(".loading").html(' <div class="overlay"><i class="fas fa-sync-alt fa-spin"></i><div class="text-bold pt-2">Loading...</div></div>');
                
            },
            success:function(data){
                $(".encargado").html(data);
                $(".loading").html('');
            }

        });
    });

</script>
   
{% endblock %}
