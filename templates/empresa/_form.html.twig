
        {{ form_start(form) }}
            <div class="row">
                <div class="col-sm-12 col-md-4">
                    <small class="text_mute">Nombre</small>
                   
                    {{ form_row(form.nombre,{'label':false,'attr':{'class':'form-control'}})}}
                    
                </div>
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">Rut</small>
                   
                    {{ form_row(form.rut,{'label':false,'attr':{'class':'form-control','data-rut-format':'','maxlength':12,'placeholder':'12.345.678-9'}})}}
                    
                </div>
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">Razón Social</small>
                   
                    {{ form_row(form.rol,{'label':false,'attr':{'class':'form-control'}})}}
                    
                </div>
                
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">Logo</small>
                   
                    {{ form_row(form.logo,{'label':false,'attr':{'class':'form-control'}})}}
                    
                </div>
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">Fecha Expiracón</small>
                   
                    {{ form_row(form.fechaVigencia,{'label':false,'attr':{'class':'form-control datetimepicker-input'}})}}
                    
                </div>
            </div>
            <hr>
            <h1>Configuración Lexflow</h1>
            <div class="row mt-3">

                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">Habilitar Lexflow</small>
                    <div class="custom-control custom-switch mt-2">
                        {{ form_widget(form.lexflowHabilitado,{'attr':{'class':'custom-control-input'}})}}
                        <label class="custom-control-label" for="{{ form.lexflowHabilitado.vars.id }}">Activo</label>
                    </div>                     
                </div>
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">API Key Estado Diario (Lexflow)</small>
                    {{ form_row(form.edapiKey,{'label':false,'attr':{'class':'form-control','placeholder':'ed_xxxxxxxx','autocomplete':'off'}})}}
                </div>
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">Cliente GUID Estado Diario (opcional)</small>
                    {{ form_row(form.edapiClienteGuid,{'label':false,'attr':{'class':'form-control'}})}}
                </div>
                <div class="col-sm-12 col-md-8">
                    <small class="text_mute">Llave privada RSA (PEM) para credenciales PJUD de Lexflow{% if empresa is defined and empresa.edapiLlavePrivada %} <span class="text-success">(ya registrada; deje vacío para conservarla)</span>{% endif %}</small>
                    {{ form_row(form.edapiLlavePrivada,{'label':false,'attr':{'class':'form-control','rows':3,'autocomplete':'off','placeholder':'-----BEGIN PRIVATE KEY-----'}})}}
                </div>
                
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">Lexflow: solo causas del CRM</small>
                    <div class="custom-control custom-switch mt-2">
                        {{ form_widget(form.lexflowSoloCrm,{'attr':{'class':'custom-control-input'}})}}
                        <label class="custom-control-label" for="{{ form.lexflowSoloCrm.vars.id }}">Activo</label>
                    </div>
                </div>
            </div>
            <hr>
            <h1>Configuración Lexflow</h1>
            <div class="row mt-3">
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">Habilitar botón Detalle PJUD</small>
                    <div class="custom-control custom-switch mt-2">
                        {{ form_widget(form.pjudHabilitado,{'attr':{'class':'custom-control-input'}})}}
                        <label class="custom-control-label" for="{{ form.pjudHabilitado.vars.id }}">Activo</label>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">API PJUD: x-client-key</small>
                    {{ form_row(form.pjudClientKey,{'label':false,'attr':{'class':'form-control','autocomplete':'off'}})}}
                </div>
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">API PJUD: email</small>
                    {{ form_row(form.pjudEmail,{'label':false,'attr':{'class':'form-control','autocomplete':'off'}})}}
                </div>
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">API PJUD: password{% if empresa is defined and empresa.pjudPassword %} <span class="text-success">(ya registrada; deje vacío para conservarla)</span>{% endif %}</small>
                    {{ form_row(form.pjudPassword,{'label':false,'attr':{'class':'form-control','autocomplete':'new-password'}})}}
                </div>

            </div>
            <hr>
            <h1>Correo (SMTP)</h1>
            <small class="text_mute d-block">Servidor con el que la empresa envía sus correos (p. ej. el correo de bienvenida del contrato). El remitente de esos correos es el que se indica aquí.</small>
            <div class="row mt-3">
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">Servidor SMTP</small>
                    {{ form_row(form.smtpHost,{'label':false,'attr':{'class':'form-control','autocomplete':'off','placeholder':'smtp.ejemplo.cl'}})}}
                </div>
                <div class="col-sm-6 col-md-2">
                    <small class="text_mute">Puerto</small>
                    {{ form_row(form.smtpPuerto,{'label':false,'attr':{'class':'form-control','autocomplete':'off','placeholder':'465'}})}}
                </div>
                <div class="col-sm-6 col-md-3">
                    <small class="text_mute">Cifrado</small>
                    {{ form_row(form.smtpCifrado,{'label':false,'attr':{'class':'form-control'}})}}
                </div>
                <div class="col-sm-6 col-md-3">
                    <small class="text_mute">Usuario</small>
                    {{ form_row(form.smtpUsuario,{'label':false,'attr':{'class':'form-control','autocomplete':'off'}})}}
                </div>
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">Contraseña</small>
                    <div class="input-group">
                        {{ form_widget(form.smtpPassword,{'label':false,'attr':{'class':'form-control','autocomplete':'new-password','value': (empresa is defined and empresa.smtpPassword) ? empresa.smtpPassword : ''}})}}
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary" id="smtpVerPasswordEmpresa" title="Mostrar/ocultar contraseña" onclick="var i=document.getElementById('{{ form.smtpPassword.vars.id }}');var v=i.type==='password';i.type=v?'text':'password';this.firstElementChild.className=v?'fas fa-eye-slash':'fas fa-eye';"><i class="fas fa-eye"></i></button>
                        </div>
                    </div>
                    {{ form_errors(form.smtpPassword) }}
                </div>
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">Correo del remitente</small>
                    {{ form_row(form.smtpRemitenteCorreo,{'label':false,'attr':{'class':'form-control','autocomplete':'off','placeholder':'contacto@ejemplo.cl'}})}}
                </div>
                <div class="col-sm-6 col-md-4">
                    <small class="text_mute">Nombre del remitente</small>
                    {{ form_row(form.smtpRemitenteNombre,{'label':false,'attr':{'class':'form-control','autocomplete':'off'}})}}
                </div>
            </div>
            <button class="btn btn-primary">{{ button_label|default('Guardar') }}</button>

            <script src="/assets/rut-format.js?v={{ 'now'|date('YmdH') }}"></script>
            <script>
               $('.datetimepicker-input').daterangepicker({
                    "singleDatePicker": true,
                    "locale": {
                        "format": "YYYY-MM-DD",
                    
                        "applyLabel": "Apply",
                        "cancelLabel": "Cancel",
                    }
                }, function(start, end, label) {
                console.log('New date range selected: ' + start.format('YYYY-MM-DD') + ' to ' + end.format('YYYY-MM-DD') + ' (predefined range: ' + label + ')');
                
                });
        
            </script>
        {{ form_end(form) }}
   