    // Genera la previsualización de cuotas mostrada en el popup de "Preparar
    // Contrato". Replica de forma simplificada la lógica de generación de
    // cuotas de PanelAbogadoController::contrata()/ContratoController::finalizar()
    // (abono/incorporación + cuotas mensuales según día de pago), solo para
    // fines de previsualización: el detalle real se recalcula en el servidor.
    function calcularCuotas(){
        var cuotas = [];
        var countCuotas = parseInt($('.cuotas').val()) || 0;
        var diaPago = parseInt($('input[name="chkDiasPago"]:checked').val()) || 1;
        var isAbono = $('.chk-bono').prop('checked');
        var isTotal = $('.chk-total').prop('checked');
        var isIncorporacion = $('.chk-incorporacion').prop('checked');
        var primeraCuotaMonto = parseInt($('.primera-cuota').val()) || 0;
        var valorCuota = parseInt($('.valor-cuota').val()) || 0;
        var numeroCuota = 1;
        var hoy = new Date();

        if(isAbono || isTotal){
            cuotas.push({numero: numeroCuota, fecha: hoy, monto: primeraCuotaMonto});
            numeroCuota++;
        }

        var fechaPrimeraCuota = hoy;
        if(isIncorporacion){
            var fInc = $('.fecha-incorporacion').val();
            fechaPrimeraCuota = fInc ? moment(fInc, 'YYYY-MM-DD').toDate() : hoy;
            cuotas.push({numero: numeroCuota, fecha: fechaPrimeraCuota, monto: primeraCuotaMonto});
            numeroCuota++;
        }

        function diaValido(mesIndexCero, dia){
            // Febrero (mes índice 1) no tiene día 30: se ajusta a 28, igual que en el backend.
            if(mesIndexCero === 1 && dia === 30){
                return 28;
            }
            return dia;
        }

        var txtFechaPago = $('.primer-pago').val();
        var partes = (txtFechaPago || '').split('-');
        var anioBase = partes[0] ? parseInt(partes[0]) : hoy.getFullYear();
        var mesBase = partes[1] ? (parseInt(partes[1]) - 1) : hoy.getMonth();

        var primerPagoFecha = new Date(anioBase, mesBase, diaValido(mesBase, diaPago));

        var sumaMeses = 0;
        if(hoy >= primerPagoFecha){
            sumaMeses = 1;
        }else if(isIncorporacion && fechaPrimeraCuota.getMonth() === hoy.getMonth() && fechaPrimeraCuota.getFullYear() === hoy.getFullYear()){
            sumaMeses = 1;
        }

        if(valorCuota !== 0){
            for(var i=0; i<countCuotas; i++){
                var mesIndex = mesBase + sumaMeses + i;
                var anio = anioBase + Math.floor(mesIndex/12);
                var mesNormalizado = ((mesIndex % 12) + 12) % 12;
                var dia = diaValido(mesNormalizado, diaPago);
                cuotas.push({numero: numeroCuota, fecha: new Date(anio, mesNormalizado, dia), monto: valorCuota});
                numeroCuota++;
            }
        }
        return cuotas;
    }

    function mostrarResumenCuotas(){
        if(!validarut()){
            return;
        }
        if(!validarCelular()){
            return;
        }
        // validarut() deja los botones deshabilitados cuando la validación es
        // exitosa (piensa que el formulario se enviará de inmediato); acá solo
        // mostramos una previsualización, así que los reactivamos.
        $('button').attr("disabled", false);

        var cuotas = calcularCuotas();
        var montoContrato = parseInt($('.monto-contrato').val()) || 0;

        $('#resumenMontoContrato').text('$' + $.number(montoContrato, 0, ',', '.'));
        $('#resumenCantidadCuotas').text(cuotas.length);

        var body = $('#resumenCuotasBody');
        body.empty();
        cuotas.forEach(function(cuota){
            body.append(
                '<tr><td>' + cuota.numero + '</td><td>' + moment(cuota.fecha).format('DD-MM-YYYY') +
                '</td><td>$' + $.number(cuota.monto, 0, ',', '.') + '</td></tr>'
            );
        });

        // El popup vive dentro de #contrato, anidado en un <section class="sticky-top">
        // (panel_agendador/new.html.twig). Ese ancestro crea su propio stacking
        // context con z-index menor al del backdrop del modal (que Bootstrap agrega
        // como hijo directo de <body>), así que el backdrop terminaba pintándose
        // por encima de todo el subárbol, incluido el propio modal. Se lo saca de
        // ahí moviéndolo a <body> justo antes de mostrarlo.
        if(!$('#modalResumenCuotas').parent().is('body')){
            $('#modalResumenCuotas').appendTo('body');
        }
        $('#modalResumenCuotas').modal('show');
    }

