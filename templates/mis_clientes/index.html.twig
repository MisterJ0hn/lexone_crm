{% extends 'base.html.twig' %}

{% block title %}Tramitación{% endblock %}

{% block body %}

<div class="card">
    <div class="card-body">
        <div class="row align-items-center">
            <h3 class="mr-3">Tramitación</h3>
            
        </div>
        <h1 class="h4 text-muted" id="total-clientes"></h1>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-3">
                <input type="text" id="bFiltro" class="form-control"
                       placeholder="Buscar por nombre, RUT o folio..." value="{{ bFiltro }}">
            </div>
            <div class="col-sm-12 col-md-3">
                <input type="text" class="form-control" name="bFecha" id="bFecha" value="">
            </div>
            <div class="col-sm-12 col-md-1">
                <button class="btn btn-primary" id="btn-buscar" type="button"><i class="fas fa-search"></i></button>
            </div>
        </div>
        <div class="row align-items-center mt-2">
            <div class="col-md-3">
                <select id="bMateria" class="form-control">
                    <option value="0">Materia</option>
                    {% for materia in materias %}
                        <option value="{{ materia.id }}">{{ materia.nombre }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <select id="bServicio" class="form-control">
                    <option value="0">Servicios</option>
                </select>
            </div>
            <div class="col-md-3">
                <select id="bUsuario" class="form-control">
                    <option value="0">Tramitador</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="bPrimerPago" class="form-control">
                    <option value="0">Cuota 1</option>
                    <option value="1">Pagada</option>
                    <option value="2">No Pagada</option>
                </select>
            </div>
            <div class="col-md-1">
                <button id="btn-limpiar" type="button" class="btn btn-dark">Limpiar</button>
            </div>
        </div>
    </div>

    <div id="resultado">
        <div class="text-center py-5"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i></div>
    </div>
</div>

<!-- Modal Observación -->
<div class="modal fade" id="observacionModal" tabindex="-1" aria-labelledby="observacionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="observacionModalLabel">Observación del Contrato</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="observacionModalBody"></div>
      </div>
    </div>
  </div>
</div>

<!-- Modal resultado de guardado -->
<div class="modal fade" id="guardadoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-body text-center">
        <p class="guardadoModalMensaje mb-3"></p>
        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<script>
$('#bFecha').daterangepicker({
    "showDropdowns": true,
    "drops": "down",
    "startDate": "{{ dateInicio }}",
    "endDate": "{{ dateFin }}",
    "locale": {"format": "YYYY-MM-DD", "applyLabel": "Aplicar", "cancelLabel": "Cancelar"}
});

var _filtrosActuales = '';
var urlContenido = "{{ path('mis_clientes_obtener_contenido') }}";
var urlFiltros   = "{{ path('mis_clientes_filtros_por_materia') }}";

function cargarFiltrosPorMateria(materiaId) {
    $.ajax({
        url: urlFiltros + '?materia=' + materiaId,
        type: 'GET',
        dataType: 'json',
        success: function(data) {
            var $servicio = $('#bServicio'), $usuario = $('#bUsuario');
            var servicioVal = $servicio.val(), usuarioVal = $usuario.val();

            $servicio.empty().append('<option value="0">Servicios</option>');
            $.each(data.servicios, function(i, s) {
                $servicio.append($('<option>').val(s.nombre).text(s.nombre));
            });
            if ($servicio.find('option').filter(function() { return this.value === servicioVal; }).length) { $servicio.val(servicioVal); }

            $usuario.empty().append('<option value="0">Tramitador</option>');
            $.each(data.usuarios, function(i, t) {
                $usuario.append($('<option>').val(t.id).text(t.nombre));
            });
            if ($usuario.find('option[value="' + usuarioVal + '"]').length) { $usuario.val(usuarioVal); }
        }
    });
}

function cargarClientes(url) {
    $('#resultado').html('<div class="text-center py-5"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i></div>');
    $('#total-clientes').html('');
    $.ajax({
        url: url,
        type: 'GET',
        dataType: 'json',
        success: function(data) {
            if (data.error) {
                $('#resultado').html($('<div class="alert alert-danger m-3">').text(data.error));
                return;
            }
            $('#resultado').html(data.html);
            $('#total-clientes').text(' ' + data.total_formateado + ' clientes ');
        },
        error: function() {
            $('#resultado').html('<div class="alert alert-danger m-3">Error al cargar los datos.</div>');
        }
    });
}

function buildFiltros() {
    return 'bFiltro=' + encodeURIComponent($('#bFiltro').val()) +
           '&bMateria=' + ($('#bMateria').val() || 0) +
           '&bServicio=' + ($('#bServicio').val() || 0) +
           '&bUsuario=' + ($('#bUsuario').val() || 0) +
           '&bPrimerPago=' + ($('#bPrimerPago').val() || 0) +
           '&bFecha=' + encodeURIComponent($('#bFecha').val());
}

function buscar() {
    _filtrosActuales = buildFiltros();
    cargarClientes(urlContenido + '?' + _filtrosActuales);
}

$(document).ready(function() {
    cargarFiltrosPorMateria(0);
    cargarClientes(urlContenido);
});

$('#btn-buscar').on('click', buscar);
$('#bFiltro').on('keypress', function(e) { if (e.which === 13) { buscar(); } });
$('#bMateria').on('change', function() {
    $('#bServicio').val('0');
    cargarFiltrosPorMateria($(this).val());
    buscar();
});
$('#bServicio, #bUsuario, #bPrimerPago, #bFecha').on('change', buscar);

$('#btn-limpiar').on('click', function() {
    $('#bFiltro').val('');
    $('#bMateria, #bServicio, #bUsuario, #bPrimerPago').val('0');
    cargarFiltrosPorMateria(0);
    _filtrosActuales = '';
    cargarClientes(urlContenido);
});

$(document).on('click', '#resultado a.page-link, #resultado th a', function(e) {
    e.preventDefault();
    var url = $(this).attr('href');
    if (url && url !== '#') {
        if (_filtrosActuales && url.indexOf('bFiltro') === -1) {
            url += (url.indexOf('?') === -1 ? '?' : '&') + _filtrosActuales;
        }
        cargarClientes(url);
    }
});
function editarObservacion(contratoId) {
    $.ajax({
        url: "/contrato/" + contratoId + "/observacion_modal",
        type: "get",
        dataType: "html",
        cache: false,
        success: function(data) {
            $(".observacionModalBody").html(data);
            $("#observacionModal").modal('show');
        },
        statusCode: {
            403: function() {
                $(".observacionModalBody").html("<p>Acceso Denegado</p>");
                $("#observacionModal").modal('show');
            }
        }
    });
}

// Historial de cambios por campo del modal (se carga por ajax la primera vez).
$(document).on('click', '.btn-historial-campo', function() {
    var boton = $(this);
    var contenedor = $(boton.attr('data-historial'));
    if (contenedor.hasClass('show')) { contenedor.collapse('hide'); return; }
    if (!contenedor.data('cargado')) {
        contenedor.html('<small class="text-muted">Cargando...</small>');
        $.ajax({
            url: boton.attr('data-url'),
            type: 'get',
            dataType: 'html',
            cache: false,
            success: function(data) { contenedor.html(data).data('cargado', true); },
            error: function() { contenedor.html('<small class="text-danger">No fue posible cargar el historial.</small>'); }
        });
    }
    contenedor.collapse('show');
});

// Avisa si el valor ingresado ya quedó registrado antes en el historial de ese campo.
$(document).on('keyup change', '.campo-con-historial', function() {
    var campo = $(this), valores = [];
    try { valores = JSON.parse(campo.attr('data-valores-historial') || '[]'); } catch (e) { valores = []; }
    var actual = $.trim(campo.val()).toLowerCase(), repetido = false;
    if (actual !== '') {
        for (var i = 0; i < valores.length; i++) {
            if ($.trim(String(valores[i])).toLowerCase() === actual) { repetido = true; break; }
        }
    }
    campo.toggleClass('border-warning', repetido);
    campo.closest('.input-group').nextAll('.aviso-valor-repetido').first().toggleClass('d-none', !repetido);
});

$(document).on('submit', '.form-observacion', function(e) {
    e.preventDefault();
    var form = $(this);
    $.ajax({
        url: form.attr('action'),
        type: 'post',
        data: form.serialize(),
        dataType: 'json',
        success: function() {
            $('#observacionModal').modal('hide');
            $('.guardadoModalMensaje').text('Guardado');
            $('#guardadoModal').modal('show');
            cargarClientes(urlContenido + (_filtrosActuales ? '?' + _filtrosActuales : ''));
        },
        error: function(xhr) {
            var msg = 'Ocurrió un error al guardar la observación.';
            if (xhr.responseJSON && xhr.responseJSON.message) { msg = xhr.responseJSON.message; }
            $('.guardadoModalMensaje').text(msg);
            $('#guardadoModal').modal('show');
        }
    });
});
</script>

{% endblock %}
