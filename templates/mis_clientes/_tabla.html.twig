<div class="table-responsive" style="min-height:200px;">
    <table class="table table-sm text-nowrap">
        <thead>
            <tr>
                <th class="pl-3">Folio</th>
                <th>Fecha</th>
                <th>Cliente</th>
                <th>Materia</th>
                <th>Servicio</th>
                <!--<th>Tramitador</th>-->
                <th title="Rit/Rol de la causa">Rit / Rol</th>
                <th>Cuota 1</th>
                <th><i class="fas fa-traffic-light"></i></th>
                <th>
                    {{ knp_pagination_sortable(contratos, 'Actividad', 'c.fechaUltimaGestion') }}
                    {% if contratos.isSorted('c.fechaUltimaGestion') %}<i class="fas fa-sort"></i>{% endif %}
                </th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        {% for contrato in contratos %}
            {% set extra = extras[contrato.id] %}
            <tr>
                <td class="pl-3">
                    <strong>{{ contrato.folio }}</strong>
                </td>
                <td>
                    {{ contrato.fechaCreacion|date('d-m-Y') }}
                    <br><small class="text-muted">{{ contrato.fechaCreacion|date('H:i') }}</small>
                </td>
                <td>
                    <strong>{{ contrato.cliente.nombre ?? '—' }}</strong>
                    {% if contrato.cliente and contrato.cliente.rut %}
                        <br><small class="text-muted">{{ contrato.cliente.rut }}</small>
                    {% endif %}
                </td>
                <td>
                    {% for materia in extra.materias %}
                        {% set svc = materia|lower %}
                        {% if 'laboral' in svc %}
                        <span class="badge badge-danger">
                            <i class="fas fa-briefcase mr-1"></i>
                            {{ materia ?? '—' }}
                        </span>
                        {% elseif 'civil' in svc %}
                        <span class="badge badge-info">
                            <i class="fas fa-balance-scale mr-1"></i>
                            
                                {{ materia ?? '—' }}
                            </span>
                        {% elseif 'familia' in svc %}
                        <span class="badge badge-primary">
                            
                            <i class="fas fa-users mr-1"></i>
                                {{ materia ?? '—' }}
                            </span>
                        {% elseif 'tributaria' in svc %}
                        <span class="badge badge-warning">
                            <i class="fas fa-home mr-1"></i>
                            
                                {{ materia ?? '—' }}
                            </span>
                        {% elseif 'penal' in svc %}
                        <span class="badge badge-warning">
                            <i class="fas fa-balance-scale mr-1"></i>
                            
                                {{ materia ?? '—' }}
                            </span>
                        {% elseif 'cobranza' in svc %}
                        <span class="badge badge-warning">
                            <i class="fas fa-home mr-1"></i>
                            
                                {{ materia ?? '—' }}
                            </span>
                        {% elseif 'corte suprema' in svc %}
                        <span class="badge badge-danger">
                            <i class="fas fa-balance-scale mr-1"></i>
                            
                                {{ materia ?? '—' }}
                            </span>
                        {% elseif 'corte apelaciones' in svc %}
                        <span class="badge badge-danger">
                            <i class="fas fa-balance-scale mr-1"></i>
                            
                                {{ materia ?? '—' }}
                            </span>
                        {% endif %}
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endfor %}
                </td>
                
               
                
                
                </td>
                <td>
                    {% for servicio in extra.servicios %}
                        {{ servicio }}{% if not loop.last %}<br>{% endif %}
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endfor %}
                </td>
             <!--   <td>
                    {{ contrato.usuarioRegistro.nombre ?? '—' }}
                </td>-->
                <td>
                    {% for rit in extra.rits %}
                        {{ rit }}{% if not loop.last %}<br>{% endif %}
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endfor %}
                </td>
                <td class="text-center">
                    {% if extra.primerPago > 0 %}
                        <i class="fas fa-times" style="color:#e74c3c;" title="Primera cuota pendiente"></i>
                    {% else %}
                        <i class="fas fa-check" style="color:#2ecc71;" title="Primera cuota pagada"></i>
                    {% endif %}
                </td>
                <td>
                    {% set pago = proximoPago(contrato.id) %}
                    {% if pago %}
                        {{ semaforoContrato(pago|date('Y-m-d'))|raw }}
                    {% endif %}
                </td>
                <td>
                    {% set dias = extra.diasActividad %}
                    {% if dias is null %}
                        <span class="text-muted">—</span>
                    {% elseif dias == 0 %}
                        <span class="text-success font-weight-bold">Hoy</span>
                    {% elseif dias == 1 %}
                        <span class="text-info">Ayer</span>
                    {% elseif dias <= 3 %}
                        <span class="text-warning">{{ dias }} días</span>
                    {% elseif dias <= 7 %}
                        <span style="color:#e6a817;">{{ dias }} días</span>
                    {% else %}
                        <span class="text-danger">{{ dias }} días</span>
                    {% endif %}
                </td>
                <td>
                    <div class="btn-group btn-group-sm" role="group">
                        {% if is_granted('create','modificar_contrato') %}
                            <a href="#" class="btn btn-dark btn-sm" onclick="editarObservacion({{ contrato.id }}); return false;"><i class="fas fa-edit"></i></a>
                        {% endif %}
                        <a href="{{ path('contrato_linea_tiempo', {'id': contrato.id}) }}" class="btn  btn-sm  text-white bg-light">LT</a>
                        {% if contrato.pdf %}
                            <a href="{{ url_web }}{{ pdf_contrato }}{{ contrato.pdf }}" class="btn btn-success btn-sm"><i class="fas fa-file-pdf"></i></a>
                        {% endif %}
                        <a href="{{ path('anexo_index', {'id': contrato.id}) }}" class="btn btn-info btn-sm"><i class="fas fa-file"></i></a>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11" class="text-center py-5">
                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                    No hay clientes activos
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="clearfix">
    <div class="navigation">
        {{ knp_pagination_render(contratos, '@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig', {}, {
            'position': 'centered',
            'rounded': true,
        }) }}
    </div>
</div>
