{% extends 'base.html.twig' %}

{% block title %}Pagos{% endblock %}

{% block body %}
<section>
    <div class="alert alert-warning">
        <h1>Total Pagos: <strong>${{total|number_format(0,',','.')}}</strong></h1>
    </div>
</section>
    <div class="card bg-calipso">
        <div class="card-header">
            <form action="" method="get">
                <div class="row">
                    <div class="col-sm-12 col-md-3">
                        <select name="bCompania" class="form-control">
                            <option value="0">Todos</option>
                            {% for compania in companias %}
                                <option value="{{compania.id}}"
                                {% if bCompania==compania.id %}
                                    selected
                                {% endif %}
                                >{{compania.nombre}}</option>
                            {% endfor %}
                        </select>
                    </div>
                     <div class="col-sm-12 col-md-2">
                    <select name="bTipofecha" class="form-control">
                        <option value="0" {% if tipoFecha==0 %}
                            selected
                        {% endif %}>Fecha Ingreso</option>
                        <option value="1" {% if tipoFecha==1 %}
                        selected
                    {% endif %}>Fecha Comprobante</option>
                    </select>
                </div>

                    <div class="col-sm-12 col-md-3">
                        <input type="text" class="form-control" name="bFecha" id="bFecha"  value="">
                    </div>
                    <div class="col-sm-12 col-md-2">
                        <button class="btn btn-primary"><i class="fas fa-search"></i></button>
                    </div>
                   
                </div>
                </form>
        </div>
    </div>
    <div class="card">
        <div class="card-body table-responsive p-0" style="height: 500px;">
        
            <div class="col-md-6 col-sm-12">

            
            <table class="table table-head-fixed text-nowrap table-striped table-sm">
                <thead>
                    <tr>
                        <th>{{ knp_pagination_sortable(pagos, 'Id Pago', 'pago.id') }} {% if pagos.isSorted('pago.id') %} <i class="fas fa-sort"></i>{% endif %}</th>
                       <!-- <th>Colaborador</th>-->
                        <th>{{ knp_pagination_sortable(pagos, 'Fecha Comprobante', 'pago.fechaPago') }} {% if pagos.isSorted('pago.fechaPago') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        <th>{{ knp_pagination_sortable(pagos, 'Fecha Ingreso', 'pago.fechaRegistro') }} {% if pagos.isSorted('pago.fechaRegistro') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        <th>{{ knp_pagination_sortable(pagos, 'Tipo Deposito', 'pago.pagoTipo') }} {% if pagos.isSorted('pago.pagoTipo') %} <i class="fas fa-sort"></i>{% endif %}</th> 
                        <th>{{ knp_pagination_sortable(pagos, 'Canal', 'pago.pagoCanal') }} {% if pagos.isSorted('pago.pagoCanal') %} <i class="fas fa-sort"></i>{% endif %}</th> 
                        <th>{{ knp_pagination_sortable(pagos, 'Boleta', 'pago.boleta') }} {% if pagos.isSorted('pago.boleta') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        <th>{{ knp_pagination_sortable(pagos, 'Monto Pagado', 'pago.monto') }} {% if pagos.isSorted('pago.monto') %} <i class="fas fa-sort"></i>{% endif %}</th>
                        
                    </tr>
                </thead>
                <tbody>
                {% set total=0 %}
                {% set num=1 %}
                {% for pago in pagos %}
              
                
                    <tr>

                        <td>{{ pago.id }}</td>
                       <!-- <td>{{pago.usuarioRegistro.nombre}}</td>-->
                        <td>{{ pago.fechaPago|date("Y-m-d H:i")}}</td>
                        <td>{{ pago.fechaRegistro|date("Y-m-d H:i") }}</td>
                        <td>{{ pago.pagoTipo }}</td>
                        <td>{{ pago.pagoCanal }}</td>
                        <td align="right">
                            {% if pago.boleta == 0 %}
                                <a href="{{ path('pago_edit',{'id':pago.id}) }}" class="btn btn-primary"><i class="fas fa-edit"></i></a>
                            {% else %}
                            {{ pago.boleta }}
                            {% endif %}
                        </td>
                        <td align="right">${{ pago.monto|number_format(0, ',', '.') }}</td>
                       
                        {% set total = total + pago.monto %}
                        {% set num = num + 1 %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">No hay pagos</td>
                    </tr>
                {% endfor %}
                
                    <tr>
                    <td colspan="6" align="right">Total:</td>
                    <td  align="right">
                         <strong>${{ total|number_format(0,",",".") }}</strong>
                    </td>
                    </tr>
                </tbody>
            </table>
        </div>
        </div>
        <div class="card-footer">
            <div class="card-footer clearfix">
                {# display navigation #}
           <div class="navigation">
               {{ knp_pagination_render(pagos,'@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig',{},{
               'position': 'centered',
               'rounded': true,
               }) }}
           </div>
       </div>
            
        </div>
    </div>
    <script>
        $('#bFecha').daterangepicker({
        
            "drops": "down",
            "startDate":"{{sesion.getEmpresaActual.fechaIngreso|date('Y-m-d')}}",
            "endDate": "{{dateFin}}",
            "locale": {
                "format": "YYYY-MM-DD",
                "applyLabel": "Apply",
                "cancelLabel": "Cancel",
            }
        }, function(start, end, label) {
        console.log('New date range selected: ' + start.format('YYYY-MM-DD') + ' to ' + end.format('YYYY-MM-DD') + ' (predefined range: ' + label + ')');
        
        });
    </script>
{% endblock %}
