{#
  Botón "Detalle PJUD" que abre el popup global. Uso:
    {% import 'pjud/_boton.html.twig' as pjud %}  {{ pjud.boton(causa.id, causa.pjud_estado|default('nuevo')) }}
  Solo se pinta si hay id de Causa del CRM (o token de fila de Lexflow); si no, no hay nada que consultar.

  Estados (igual que Lexflow): nuevo (sin sincronizar, amarillo), sincronizando (verde, girando),
  error (rojo, tachado) y listo (martillo del Poder Judicial). El estado inicial viene de la fila
  (`pjud_estado`, consultado a api-pjud al listar); después lo maneja /build/js/pjud-popup.js
  (clic, polling y respuestas del popup).
#}
{% macro boton(causaId, estado = 'nuevo') %}
    {% set estado = estado in ['sincronizando', 'error', 'listo'] ? estado : 'nuevo' %}
    {% set titulos = {nuevo: 'Aún no se ha sincronizado con el Poder Judicial', sincronizando: 'Sincronizando con el Poder Judicial...', error: 'La sincronización con el Poder Judicial falló', listo: 'Detalle PJUD'} %}
    {% if causaId %}
        <button type="button" class="btn btn-outline-primary btn-sm px-2 pjud-e-{{ estado }}" data-pjud-causa="{{ causaId }}" data-pjud-estado="{{ estado }}" title="{{ titulos[estado] }}" aria-label="Ver detalle de la causa en el Poder Judicial">
            {% if estado == 'sincronizando' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
            {% elseif estado == 'listo' %}
          
              <img src="/build/img/martillo_pjud.png" alt="" width="16" height="16">
            {% else %}
              <i class="fas fa-{{ {nuevo: 'sync', error: 'eye-slash'}[estado] }}"></i>
            {% endif %}
        </button>
    {% endif %}
{% endmacro %}
