###> cifrado datos sensibles Cliente (App\Security\Cifrado) ###
# IMPORTANTE: sobreescribir estos valores en .env.local con secretos reales y NO commitearlos.
# Si se pierden o cambian, los datos ya cifrados en la base quedan indescifrables.
# APP_ENCRYPTION_KEY: 32 bytes en base64. Generar con: php -r "echo base64_encode(random_bytes(32));"
APP_ENCRYPTION_KEY=c3mckqQ5/9mdB7jOatiquvy+YJb/jFL9z0GoTr3PrhA=
# APP_HASH_PEPPER: secreto para el HMAC-SHA256 usado en las columnas *_hash (búsqueda exacta)
APP_HASH_PEPPER=your_hash_pepper_here
###< cifrado datos sensibles Cliente ###

